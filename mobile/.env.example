# Copy this file to `.env` (same folder) and fill in the real value.
# Never commit `.env` — it's gitignored.

# Same Convex deployment the web app (../.env.local's VITE_CONVEX_URL) points at.
CONVEX_URL=https://your-project-id.convex.cloud

# Origin of the deployed web app (no trailing slash). Used to build the public
# profile (/photographer/<username>) and packages links shown on the Profile tab.
WEB_URL=https://your-web-app.example.com
